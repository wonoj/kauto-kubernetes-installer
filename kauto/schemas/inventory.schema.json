{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kauto/schemas/inventory.v1alpha1.json",
  "title": "Kauto inventory configuration, design v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "ssh", "nodes", "networks"],
  "properties": {
    "apiVersion": {"const": "kauto.config/v1alpha1"},
    "kind": {"const": "Inventory"},
    "metadata": {"type": "object", "additionalProperties": false,
      "required": ["clusterName"],
      "properties": {"clusterName": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"}}
    },
    "ssh": {"type": "object", "additionalProperties": false,
      "required": ["user", "port", "knownHostsFile", "hostKeyChecking", "become"],
      "properties": {
        "user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]*$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "knownHostsFile": {"type": "string", "pattern": "^/[^\\n]+$"},
        "hostKeyChecking": {"const": "strict"},
        "become": {"const": "sudo"}
      }
    },
    "nodes": {"type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "address", "role", "nodeIP"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"},
          "address": {"type": "string", "minLength": 1},
          "role": {"enum": ["control-plane", "worker"]},
          "nodeIP": {"type": "string", "minLength": 1},
          "sshUser": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]*$"},
          "sshPort": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "networks": {"type": "object", "additionalProperties": false,
      "required": ["externalCIDRs"],
      "properties": {
        "externalCIDRs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
